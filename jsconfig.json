{
    "compilerOptions": {
        "baseUrl": "./",
        "paths": {
            "@/*": [
                "src/*"
            ],
            "@components/*": [
                "src/components/*"
            ],
            "@lib/*": [
                "src/lib/*"
            ],
            "@assets/*": [
                "src/assets/*"
            ],
            "@constants/*": [
                "src/constants/*"
            ],
            "@hooks/*": [
                "src/hooks/*"
            ],
            "@navigation/*": [
                "src/navigation/*"
            ],
            "@screens/*": [
                "src/screens/*"
            ],
            "@store/*": [
                "src/store/*"
            ],
            "@theme/*": [
                "src/theme/*"
            ],
            "@utils/*": [
                "src/utils/*"
            ],
            "@context/*": [
                "src/context/*"
            ]
        }
    }
}