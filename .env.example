EXPO_PUBLIC_API_URL=

# ─── Auth / Sync ────────────────────────────────────
# Backend API URL (auth ve sync endpointleri bu URL üzerinden erişilir)
# Örnek: https://api.example.com
# /api/auth/* ve /api/sync/* yolları otomatik eklenir.

# ─── APK Güncelleme ────────────────────────────────
# GitHub deposu (owner/repo). APK güncelleme bu depodaki "latest release"
# yayınından okur. BOŞ BIRAKILIRSA güncelleme kapalı olur — uygulama yine
# çalışır, yalnızca güncelleme satırı "kullanılamıyor" der.
# Örnek: darkpuye/StreamPulse
EXPO_PUBLIC_GITHUB_REPO=

# Opsiyonel: GitHub PAT. Yalnızca saatlik 60 isteklik rate limit'i aşmak
# için gerekir (güncelleme kontrolü açılışta 1 kez çalıştığı için çoğu
# durumda boş bırakılabilir). Bu değer APK'nın İÇİNE gömülür; gömülecekse
# bir sır sayılmalıdır — sır gerekiyorsa BOŞ BIRAKIN.
EXPO_PUBLIC_GITHUB_TOKEN=