	"scripts": {
		"start": "expo start",
		"clean-start": "expo start -c",
		"reset-project": "node ./scripts/reset-project.js",
		"icons": "node scripts/generate-icons/generate.mjs",
		"icons:preview": "node scripts/generate-icons/preview.mjs",
		"icons:verify": "node --no-warnings scripts/generate-icons/verify.mjs",
		"verify:splash": "node --no-warnings scripts/verify-splash-variants.mjs",
		"ios": "expo run:ios",
		"android": "expo run:android",
