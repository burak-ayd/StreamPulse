		"clean:release": "cross-env EXPO_TV=1 APP_VARIANT=release bunx expo prebuild --clean",
		"tv": "cross-env EXPO_TV=1 APP_VARIANT=development bunx expo prebuild --clean && bun expo run:android --variant debug",
		"build:dev:tv": "cross-env EXPO_TV=1 APP_VARIANT=development node scripts/build.js apk",
		"build:preview:tv": "cross-env EXPO_TV=1 APP_VARIANT=preview node scripts/build.js apk",
