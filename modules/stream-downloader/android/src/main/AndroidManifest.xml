<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Pil optimizasyonu istisnası istemi (izinler ekranı). -->
  <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
  <!--
    Android 14+ (targetSdk 34+): startForeground(..., FORE...DATA_SYNC) için
    ZORUNLU. Eksikse SecurityException atılır; çağıran catch yutsa bile
    startForegroundService sözü 5 sn içinde yerine getirilmediği için
    "ForegroundServiceDidNotStartInTimeException" ile uygulama çöker.
  -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
  <application>
    <service
      android:name=".DownloadService"
      android:exported="false"
      android:foregroundServiceType="dataSync" />
  </application>
</manifest>
