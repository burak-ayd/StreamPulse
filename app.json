{
  "expo": {
    "name": "Stream Pulse",
    "slug": "StreamPulse",
    "version": "1.0.52",
    "orientation": "default",
    "icon": "./assets/icons/release/icon.png",
    "scheme": "streampulse",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/icons/release/icon.png"
    },
    "android": {
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "REQUEST_INSTALL_PACKAGES",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_DATA_SYNC",
        "android.permission.WAKE_LOCK",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#0B0E14",
        "foregroundImage": "./assets/icons/release/icon-adaptive-foreground.png",
        "backgroundImage": "./assets/icons/release/icon-adaptive-background.png",
        "monochromeImage": "./assets/icons/release/icon-adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "tr.net.burakaydogan.streampulse",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "streampulse"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/icons/release/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icons/release/notification-icon.png",
          "defaultChannel": "default",
          "enableRemoteNotifications": true,
          "enableBackgroundRemoteNotifications": true,
          "color": "#FF3D5E"
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0E14",
          "image": "./assets/icons/release/splash-icon.png",
          "imageWidth": 260
        }
      ],
      "expo-web-browser",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "DEFAULT"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "useLegacyPackaging": true,
            "enablePngCrunchInReleaseBuilds": true,
            "extraManifestParams": {
              "application": {
                "android:banner": "@drawable/notification_icon"
              }
            }
          }
        }
      ],
      [
        "@react-native-tvos/config-tv",
        {
          "isTV": true,
          "showVerboseWarnings": false,
          "tvosDeploymentTarget": "15.1",
          "removeFlipperOnAndroid": true,
          "androidTVBanner": "./assets/icons/release/tv-banner.png",
          "androidTVIcon": "./assets/icons/release/icon.png",
          "appleTVImages": {
            "icon": "./assets/icons/release/tv-icon.png",
            "iconSmall": "./assets/icons/release/tv-icon-small.png",
            "iconSmall2x": "./assets/icons/release/tv-icon-small-2x.png",
            "topShelf": "./assets/icons/release/tv-topshelf.png",
            "topShelf2x": "./assets/icons/release/tv-topshelf-2x.png",
            "topShelfWide": "./assets/icons/release/tv-topshelf-wide.png",
            "topShelfWide2x": "./assets/icons/release/tv-topshelf-wide-2x.png"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "@react-native-vector-icons/ionicons",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-secure-store",
      "expo-updates",
      "./scripts/withSplitApk.js",
      "./scripts/withGradleJvmArgs.js",
      "./scripts/withCustomApkName.js",
      "./scripts/withFileProvider.js",
      "./scripts/withBuildOptimizations.js",
      "./scripts/withTVArch.js",
      "./scripts/withAndroidTV.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6e7b0adb-396f-4d06-b66d-bea82406c890"
      },
      "variant": "production",
      "API_URL": "https://movieapi.burakaydogan.net.tr"
    },
    "owner": "darkpuye"
  }
}
