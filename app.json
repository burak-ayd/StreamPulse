{
  "expo": {
    "name": "Stream Pulse",
    "slug": "StreamPulse",
    "version": "1.0.2",
    "orientation": "default",
    "icon": "./assets/images/logo.png",
    "scheme": "streampulse",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/images/logo.png"
    },
    "android": {
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "REQUEST_INSTALL_PACKAGES"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0B0E14",
        "foregroundImage": "./assets/images/logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "tr.net.burakaydogan.StreamPulse",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "streampulse"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-notifications",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0E14",
          "image": "./assets/images/logo.png",
          "imageWidth": 80
        }
      ],
      "expo-web-browser",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "DEFAULT"
        }
      ],
      "@react-native-community/datetimepicker",
      "@react-native-vector-icons/ionicons",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-secure-store",
      "./scripts/withSplitApk.js",
      "./scripts/withGradleJvmArgs.js",
      "./scripts/withCustomApkName.js",
      "./scripts/withFileProvider.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6e7b0adb-396f-4d06-b66d-bea82406c890"
      }
    },
    "owner": "darkpuye"
  }
}
